Данные скрипты могу помочь для создания виртуальных машин 


#!/bin/bash

read -p "Пул (sg1/ps2): " POOL
read -p "Количество (3): " N
read -p "Старт ID (200): " START_ID
read -p "vmbr локалки (20): " LOCAL_VMB_NUM
read -p "Template ID (100): " TEMPLATE_ID

LOCAL_BRIDGE="vmbr$LOCAL_VMB_NUM"

# Создать локальный бридж группы
if ! ip link show $LOCAL_BRIDGE > /dev/null 2>&1; then
    echo "Создаем $LOCAL_BRIDGE..."
    cat >> /etc/network/interfaces << EOF
auto $LOCAL_BRIDGE
iface $LOCAL_BRIDGE inet manual
  bridge-ports none
  bridge-stp off
  bridge-fd 0
EOF
    ifup $LOCAL_BRIDGE
fi

# СОЗДАТЬ VM с ПРАВИЛЬНЫМ именем (vm200-vm202)
for((i=0; i<N; i++)); do
    VMID=$((START_ID+i))
    VMNAME="vm$VMID"  # ✅ ПРАВИЛЬНЫЙ формат: vm200, vm201...
    
    qm clone $TEMPLATE_ID $VMID --name "$VMNAME" --full 1
    qm set $VMID --net1 "virtio,bridge=$LOCAL_BRIDGE"
    echo "✅ VM$VMID ($VMNAME): net0=vmbr0 + net1=$LOCAL_BRIDGE"
done



#!/bin/bash

read -p "Clone count: " n
read -p "Start ID: " i
read -p "Number vmbr: " v
read -p "Template ID: " t

b="vmbr$v"

if ! ip link show $b > /dev/null 2>&1; then
  echo "auto $b
iface $b inet manual
  bridge-ports none
  bridge-stp off
  bridge-fd 0" >> /etc/network/interfaces
  ifup $b
fi

for((c=0;c<n;c++)); do
  vm=$((i+c))
  qm clone $t $vm --name "vm$vm"
  qm set $vm --net1 virtio,bridge=$b
done
